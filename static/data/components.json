    {
        "name": "Responsive Navbar",
        "category": "Components",
        "description": "A navigation bar that collapses into a hamburger menu on smaller screens.",
        "code": "<style>\\n    .responsive-nav {\\n        background-color: #333;\\n        overflow: hidden;\\n        position: relative;\\n        font-family: sans-serif;\\n    }\\n    .responsive-nav a {\\n        color: white;\\n        padding: 14px 16px;\\n        text-decoration: none;\\n        font-size: 17px;\\n        display: block;\\n    }\\n    .responsive-nav a.icon {\\n        background: black;\\n        display: block;\\n        position: absolute;\\n        right: 0;\\n        top: 0;\\n    }\\n    .responsive-nav a:not(.icon) {\\n        display: none;\\n    }\\n    .responsive-nav.responsive a:not(.icon) {\\n        display: block;\\n        text-align: left;\\n    }\\n    .responsive-nav.responsive {\\n        position: relative;\\n    }\\n    .responsive-nav.responsive a.icon {\\n        position: absolute;\\n        right: 0;\\n        top: 0;\\n    }\\n</style>\\n<script>\\n    function toggleNav() {\\n        var x = document.getElementById(\"myTopnav\");\\n        if (x.className === \"responsive-nav\") {\\n            x.className += \" responsive\";\\n        } else {\\n            x.className = \"responsive-nav\";\\n        }\\n    }\\n</script>\\n\\n<div class=\"responsive-nav\" id=\"myTopnav\">\\n  <a href=\"#home\" class=\"active\">Home</a>\\n  <a href=\"#news\">News</a>\\n  <a href=\"#contact\">Contact</a>\\n  <a href=\"javascript:void(0);\" class=\"icon\" onclick=\"toggleNav()\">\\n    &#9776; <!-- Hamburger Icon -->\\n  </a>\\n</div>\\n"
    },
