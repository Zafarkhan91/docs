        "code": "<style>\\n    .navbar {\\n        background-color: #333;\\n        overflow: hidden;\\n        font-family: sans-serif;\\n    }\\n    .navbar a {\\n        float: left;\\n        display: block;\\n        color: white;\\n        text-align: center;\\n        padding: 14px 20px;\\n        text-decoration: none;\\n    }\\n    .navbar a:hover {\\n        background-color: #ddd;\\n        color: black;\\n    }\\n</style>\\n\\n<div class=\"navbar\">\\n    <a href=\"#home\">Home</a>\\n    <a href=\"#news\">News</a>\\n    <a href=\"#contact\">Contact</a>\\n    <a href=\"#about\">About</a>\\n</div>"
